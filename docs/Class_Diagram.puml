@startuml
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members

title Snake - UML Diagram (Language-Agnostic)

package "Config & Data" {
    class ScoreManager <<service>> {
        + ensureDataExists(): void
        + loadScores(): Collection
        + addNewScore(user: String, score: Integer, time: Long, state: GameState): Collection
    }
}

enum GameState {
    MENU
    PLAYING
    LOSE
    WIN
}

class Game {
    - state: GameState
    - directionLock: Boolean
    - moveDelayMs: Integer
    - lastMoveTimestamp: Long
    - startTimestamp: Long
    - scoreSaved: Boolean
    + run(): void
    - handleEvents(): void
    - update(): void
    - draw(): void
    - handleGameOver(resultState: GameState): void
    + resetGame(): void
}

class Snake {
    - segments: Collection
    - direction: Direction
    - score: Integer
    + reset(): void
    + getNextHeadPosition(): Point
    + move(newHead: Point, growing: Boolean): void
    + checkCollision(head: Point): Boolean
}

class Apple {
    - position: Point
    + spawn(snakeSegments: Collection): void
}

class Menu {
    - active: Boolean
    - countdown: Boolean
    - timer: Integer
    - selectedIndex: Integer
    - currentOptions: Collection
    + update(): void
    + handleInput(event: InputEvent): String
    + pause(): void
    + startCountdown(): void
    - executeOption(): String
}

class WindowManager {
    - logicalResolution: Point
    - virtualSurface: Surface
    - screen: Surface
    - monitorWidth: Integer
    - monitorHeight: Integer
    - windowSize: Integer
    - fullscreen: Boolean
    + toggleFullscreen(): void
    + toggleResizable(canResize: Boolean): void
    + finalRender(): void
}

class Render {
    - titleRatio: Float
    - standardRatio: Float
    - scoreRatio: Float
    + draw(snake: Snake, apple: Apple): void
    + drawMenu(menu: Menu): void
    - getFont(ratio: Float): Font
    - drawGrid(): void
    - drawScore(score: Integer): void
}

class StateRender {
    - selectedIndex: Integer
    + drawOverlay(state: GameState, score: Integer): void
    - getFont(ratio: Float): Font
    - drawHighscoreTable(): void
}

' --- Named UML Relationships ---
Game *-- Snake : composition
Game *-- Apple : composition
Game *-- Menu : composition
Game *-- WindowManager : composition
Game *-- Render : composition
Game *-- StateRender : composition

Render o-- WindowManager : aggregation
StateRender --> WindowManager : association

Game ..> ScoreManager : usage
StateRender ..> ScoreManager : usage

package "pygame Dependency Map (Impact Scope)" {
    class "<<external>> pygame" as PygameLib

    class "config/constants.py" as FileConstants <<file>>
    class "game/game.py" as FileGame <<file>>
    class "game/menu.py" as FileMenu <<file>>
    class "view/render.py" as FileRender <<file>>
    class "view/state_render.py" as FileStateRender <<file>>
    class "view/window_manager.py" as FileWindowManager <<file>>

    FileConstants ..> PygameLib : direct import
    FileGame ..> PygameLib : direct import
    FileStateRender ..> PygameLib : direct import
    FileWindowManager ..> PygameLib : direct import

    FileMenu ..> FileConstants : usage via constants
    FileRender ..> FileConstants : usage via constants
    FileMenu ..> PygameLib : indirect dependency
    FileRender ..> PygameLib : indirect dependency
}

@enduml