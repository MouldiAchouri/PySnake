@startuml
skinparam style strictuml
skinparam monochrome true
skinparam shadowing false
hide empty members

enum GameState {
    PLAYING
    MENU
    LOSE
    WIN
}

enum Direction {
    UP
    DOWN
    LEFT
    RIGHT
}

class Game {
    - directionLock: Boolean
    - moveDelay: Integer
    - lastMoveTime: Long
    - state: GameState
    + run(): void
    - handleEvents(): void
    - changeDirection(key: KeyCode): void
    - update(): void
    - draw(): void
    - toggleFullscreen(): void
    - resetGame(): void
}

class Snake {
    + segments: Point[]
    + direction: Direction
    + score: Integer
    + reset(): void
    + getNextHeadPosition(): Point
    + move(newHead: Point, isGrowing: Boolean): void
    + checkCollision(head: Point): Boolean
}

class Apple {
    + position: Point
    + spawn(occupiedCells: Point[]): void
}

class Render {
    + draw(snake: Snake, apple: Apple): void
    + drawMenu(menu: Menu): void
    - drawGrid(): void
    - drawApple(apple: Apple): void
    - drawSnake(snake: Snake): void
    - drawScore(score: Integer): void
}

class Menu {
    + active: Boolean
    + countdown: Boolean
    - selectedIndex: Integer
    - options: String[]
    + update(): void
    + handleInput(event: Event): String
    + pause(): void
    - executeOption(): String
}

class StateRender {
    - options: String[]
    - selectedIndex: Integer
    + drawOverlay(state: GameState, score: Integer): void
    - drawCenteredText(text: String, offset: Integer): void
}

Game *-- Snake : manages >
Game *-- Apple : manages >
Game *-- Render : delegates rendering >
Game *-- Menu : controls >
Game *-- StateRender : handles UI >

Render ..> Snake : uses
Render ..> Apple : uses
StateRender ..> GameState : references
@enduml